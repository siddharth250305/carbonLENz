# Copy to .env. All keys are optional: without them the deterministic rules engine extracts evidence.

# Primary extraction engine (also reads scanned PDFs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary engine, used if Gemini is not configured or fails
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Express API port (Vite proxies /api here)
PORT=5001
